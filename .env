# Copy this file to ".env" (same folder) and edit the values.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=grain_inventory

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=5000
TOKEN_HOURS=12
# SECRET_KEY=   # optional; if empty a key is generated once and saved in backend_api/.secret_key

# ---- Frontend (Streamlit) ----
# Address of the backend. Use the server's IP if the cashier PC is a different machine.
API_URL=http://localhost:5000/api

# Printed on every bill
SHOP_NAME=Grain Store
SHOP_ADDRESS=Main Market Road, Pune
SHOP_PHONE=+91 98765 43210
